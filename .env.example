# ------------------------------------------------------------------
# OBRIGATÓRIO em produção
# ------------------------------------------------------------------

# Senha de acesso ao site. As chaves de API ficam no servidor, então quem entra
# gasta o seu saldo — sem esta variável o site fica ABERTO na internet.
DUELO_SENHA=

# ------------------------------------------------------------------
# Chaves de IA — configure pelo menos DUAS
# ------------------------------------------------------------------

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Modelos (opcional). Sem isso, usa um padrão sensato de cada fornecedor.
# ANTHROPIC_MODEL=claude-opus-4-5
# OPENAI_MODEL=gpt-5.1
# DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------------------------------
# Busca web (opcional) — permite citar fontes verificáveis
# ------------------------------------------------------------------

# BRAVE_API_KEY=
# TAVILY_API_KEY=
# Qual usar, se as duas estiverem definidas: brave | tavily
# BUSCA_PROVIDER=brave

# ------------------------------------------------------------------
# Documentos (upload de planilha, PDF, Word, texto)
# ------------------------------------------------------------------

# Supabase Storage. Sem estas duas variáveis o upload grava em disco local,
# o que serve para desenvolvimento mas não sobrevive a um novo deploy.
# A chave service_role fica SÓ no servidor — nunca exponha no navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Nome do bucket. Criado automaticamente na primeira utilização.
# DUELO_BUCKET=documentos

# ------------------------------------------------------------------
# Reconhecimento de documento digitalizado (OCR)
# ------------------------------------------------------------------

# Usa os modelos de visão já configurados acima — não precisa de chave nova.
# Desligue com "false" se quiser evitar o custo por página.
# OCR_ATIVO=true

# Teto de páginas por documento. Cada página é uma chamada cobrada.
# OCR_MAX_PAGINAS=30

# Modelo só para transcrição. Um modelo mais barato costuma bastar,
# já que a tarefa é copiar texto, não raciocinar.
# OCR_MODEL=

# ------------------------------------------------------------------
# Endpoints alternativos (proxy, gateway compatível, testes)
# ------------------------------------------------------------------

# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=
# DEEPSEEK_BASE_URL=
# BRAVE_BASE_URL=
# TAVILY_BASE_URL=
